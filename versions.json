  },
  "evidence_tools": {
    "cosign": "3.1.1",
    "oras": "1.3.2"
  },
  "security_tools": {
    "semgrep": "1.166.0",
    "osv_scanner": "2.3.8",
    "grype": "0.114.0",
    "syft": "1.45.1",
    "checkov": "3.3.1",
    "hadolint": "2.14.0",
    "license_finder": "7.2.1",
